# Copier en .env (gitignored) avant de lancer :
#   docker compose -f data-platform/docker-compose.yml --env-file data-platform/.env up -d
# Ces mêmes variables sont lues par les scripts Python (scripts/config.py), qui chargent
# automatiquement data-platform/.env si python-dotenv est installé.

# --- Data Warehouse (postgres-dwh) ---
DWH_HOST=localhost
DWH_PORT=5433
DWH_USER=dwh_user
DWH_PASSWORD=dwh_password
DWH_DB=dwh

# --- MinIO (data lake) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password_2026
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password_2026
MINIO_BUCKET=data-lake

# --- API TCGWorld (remplace l'API Flask simulée du cahier des charges) ---
# Doit correspondre à Analytics:ExportToken côté server/TcgWorld.Api (appsettings ou env
# Analytics__ExportToken).
MARKETPLACE_API_URL=http://localhost:5009/api/analytics-export
MARKETPLACE_API_TOKEN=formation-token-2026
